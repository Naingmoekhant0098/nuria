                                    "type": "text"
                                },
                                {
                                    "key": "service_id",
                                    "value": "{{service_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "appointment_at",
                                    "value": "{{appointment_at}}",
                                    "type": "text"
                                },
                                {
                                    "key": "payment_method",
                                    "value": "KBZPay",
                                    "type": "text"
                                },
                                {
                                    "key": "transaction_code",
                                    "value": "TXN-123456",
                                    "type": "text"
                                },
                                {
                                    "key": "payment_image",
                                    "type": "file",
                                    "src": ""
                                },
                                {
                                    "key": "remarks",
                                    "value": "Postman test booking",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": "{{base_url}}/api/v1/reservations"
                    }
                },
                {
                    "name": "List my reservations",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/reservations"
                    }
                },
                {
                    "name": "Browse shop products",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/products?clinic_id={{clinic_id}}&search={{search}}"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const item = pm.response.json().data?.find((product) => product.type === pm.collectionVariables.get(\"shop_item_type\")) ?? pm.response.json().data?.[0];",
                                    "if (item?.id) pm.collectionVariables.set(\"shop_item_id\", item.id);",
                                    "if (item?.type) pm.collectionVariables.set(\"shop_item_type\", item.type);",
                                    "if (item?.units?.[0]?.id) pm.collectionVariables.set(\"drug_unit_id\", item.units[0].id);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "View cart",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/cart?clinic_id={{clinic_id}}"
                    }
                },
                {
                    "name": "Add item to cart",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const item = pm.response.json().item;",
                                    "if (item?.id) pm.collectionVariables.set(\"cart_item_id\", item.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/cart/items",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"clinic_id\": \"{{clinic_id}}\",\n  \"item_type\": \"{{shop_item_type}}\",\n  \"item_id\": \"{{shop_item_id}}\",\n  \"drug_unit_id\": \"{{drug_unit_id}}\",\n  \"quantity\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Update cart item quantity",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/cart/items/{{cart_item_id}}",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quantity\": 2\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Checkout cart",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const order = pm.response.json().order;",
                                    "if (order?.id) pm.collectionVariables.set(\"order_id\", order.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/checkout",
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "clinic_id",
                                    "value": "{{clinic_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "delivery_address",
                                    "value": "Yangon",
                                    "type": "text"
                                },
                                {
                                    "key": "delivery_contact",
                                    "value": "09123456789",
                                    "type": "text"
                                },
                                {
                                    "key": "payment_method",
                                    "value": "KBZPay",
                                    "type": "text"
                                },
                                {
                                    "key": "transaction_code",
                                    "value": "TXN-123456",
                                    "type": "text"
                                },
                                {
                                    "key": "payment_image",
                                    "type": "file",
                                    "src": ""
                                },
                                {
                                    "key": "order_note",
                                    "value": "Please call on delivery",
                                    "type": "text"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "List my shop orders",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/orders"
                    }
                },
                {
                    "name": "Show shop order",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/shop/orders/{{order_id}}"
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{patient_token}}"
                            }
                        ],
                        "url": "{{base_url}}/api/v1/logout"
                    }
                },
                {
                    "name": "Optional cart cleanup",
                    "item": [
                        {
                            "name": "Remove cart item (optional cleanup)",
                            "request": {
                                "method": "DELETE",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    },
                                    {
                                        "key": "Authorization",
                                        "value": "Bearer {{patient_token}}"
                                    }
                                ],
                                "url": "{{base_url}}/api/v1/shop/cart/items/{{cart_item_id}}"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
